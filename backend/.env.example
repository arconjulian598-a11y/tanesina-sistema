# Copia este archivo como .env

PORT=3000
JWT_SECRET=cambia_esta_clave_secreta
JWT_EXPIRES=8h

# OPCIÓN A — una sola URL (Render la entrega automáticamente como DATABASE_URL)
# DATABASE_URL=postgres://usuario:password@host:5432/basedatos

# OPCIÓN B — variables sueltas para desarrollo local con PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password
DB_NAME=tamesina

# Pon PGSSL=off solo en local si tu PostgreSQL no usa SSL
PGSSL=off
